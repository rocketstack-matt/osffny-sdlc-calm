{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hub.calm.finos.org/calm/namespaces/finos.agentic-sdlc/standards/governed-node/versions/1.0.0",
  "title": "Governed node",
  "description": "What every node in this estate must carry for the gates to work. Services declare where their code lives, so the gates can tell which node a changed file belongs to and which connections its code makes; every interface declares its environment binding.",
  "allOf": [
    {
      "$ref": "https://calm.finos.org/release/1.2/meta/core.json#/defs/node"
    },
    {
      "if": {
        "properties": {
          "node-type": {
            "const": "service"
          }
        },
        "required": [
          "node-type"
        ]
      },
      "then": {
        "properties": {
          "metadata": {
            "type": "object",
            "properties": {
              "source-path": {
                "type": "string",
                "pattern": "^[^/].*[^/]$",
                "description": "Repository directory that holds this node's code"
              }
            },
            "required": [
              "source-path"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "https://hub.calm.finos.org/calm/namespaces/finos.agentic-sdlc/standards/env-binding-interface/versions/1.0.0"
          }
        }
      }
    }
  ]
}
